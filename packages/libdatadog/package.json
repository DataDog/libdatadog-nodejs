{
  "name": "@datadog/libdatadog",
  "version": "0.1.0-pre",
  "description": "WASM Node.js bindings for libdatadog",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DataDog/libdatadog-nodejs.git",
    "directory": "packages/libdatadog"
  },
  "homepage": "https://github.com/DataDog/libdatadog-nodejs#readme",
  "bugs": {
    "url": "https://github.com/DataDog/libdatadog-nodejs/issues"
  },
  "type": "commonjs",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.js",
      "default": "./index.js"
    },
    "./wasm": {
      "types": "./index.d.ts",
      "import": "./wasm.mjs",
      "require": "./wasm.js",
      "default": "./wasm.js"
    },
    "./remote-config": {
      "types": "./remote-config.d.ts",
      "import": "./remote-config.js",
      "require": "./remote-config.js",
      "default": "./remote-config.js"
    },
    "./zstd": {
      "types": "./zstd.d.ts",
      "import": "./zstd.mjs",
      "require": "./zstd.js",
      "default": "./zstd.js"
    }
  },
  "files": [
    "README.md",
    "index.js",
    "index.mjs",
    "remote-config.js",
    "remote-config.d.ts",
    "zstd.js",
    "zstd.mjs",
    "zstd.d.ts",
    "wasm.js",
    "wasm.mjs",
    "index.d.ts",
    "lib/"
  ],
  "workspaces": [
    "wasm"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "benchmark:agentless": "npm run build:wasm:binary && npm run inline:wasm && node benchmark/agentless-pipeline.js",
    "build:wasm": "npm run build:wasm:binary && npm run build:zstd:binary && npm run build:remote-config:binary && npm run inline:wasm && npm run inline:zstd && npm run inline:remote-config",
    "build:wasm:binary": "node ../../scripts/build-wasm.js ../../crates/libdatadog-wasm wasm/dist",
    "build:zstd:binary": "node ../../scripts/build-wasm.js ../../crates/libdatadog-wasm-zstd wasm/dist/zstd",
    "build:remote-config:binary": "node ../../scripts/build-wasm.js ../../crates/remote_config wasm/dist/remote-config",
    "size:profile": "node ../../scripts/build-wasm.js ../../crates/libdatadog-wasm ../../target/size --profiling",
    "inline:wasm": "node scripts/inline-wasm.js libdatadog_wasm wasm/dist",
    "inline:zstd": "node scripts/inline-wasm.js libdatadog_wasm_zstd wasm/dist/zstd",
    "inline:remote-config": "node scripts/inline-wasm.js remote_config wasm/dist/remote-config",
    "report:wasm-size": "node scripts/report-wasm-size.js",
    "build": "npm run build:wasm",
    "test": "node scripts/run-tests.js && npm run test:types",
    "test:package": "node --test test/package-contents.test.js",
    "test:types": "tsc --noEmit --strict --target ES2022 --module Node16 --moduleResolution Node16 test/types.test.ts"
  },
  "dependencies": {
    "@datadog/libdatadog-wasm": "0.1.0-pre"
  },
  "devDependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "esbuild": "^0.28.2",
    "typescript": "^6.0.3",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.2"
  }
}
